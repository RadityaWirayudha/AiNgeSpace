# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
# `/build/*` rather than `/build`: git does not descend into an excluded
# directory, so a `!` exception inside one is never reached.
/build/*
# The app icon is a source asset — electron-builder reads it from
# buildResources, so a fresh clone without it fails `npm run build:desktop`.
# Regenerate with `node scripts/make-icon.mjs`.
!/build/icon.png

# desktop build output
/dist
/dist-electron

# misc
.DS_Store
*.pem

# Windows reserved device name, created accidentally by `2>nul` redirects in
# Git Bash. Turbopack crashes trying to read it (os error 1).
/nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
