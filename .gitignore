# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns here are deliberately NOT anchored with a leading slash: the repo now
# holds two projects side by side (purpspace-electron/, purpspace-webapp/), and
# an anchored pattern like `/node_modules` would only ever match the root — the
# copies one level down would get committed. Anything that belongs to exactly one
# project lives in that project's own .gitignore instead.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# misc
.DS_Store
*.pem

# Windows reserved device name, created accidentally by `2>nul` redirects in
# Git Bash. Turbopack crashes trying to read it (os error 1).
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
